# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y cambia los valores.
# NUNCA subas el archivo .env al repositorio.
# ============================================

# --- Servidor ---
PORT=3000
# development muestra detalles de errores; en producción usa: production
NODE_ENV=development

# --- Base de datos (OBLIGATORIAS) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_la_bd
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=expedientes_estudiantiles
DB_CONNECTION_LIMIT=10
# 0 = sin límite de cola
DB_QUEUE_LIMIT=0

# --- JWT (OBLIGATORIA) ---
# Genera un valor largo y aleatorio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# --- Archivos subidos ---
# Tamaño máximo en bytes (10485760 = 10 MB)
MAX_FILE_SIZE=10485760

# --- CORS (OBLIGATORIA) ---
# Orígenes permitidos separados por coma
CORS_ORIGIN=http://localhost:3000

# --- Seguridad ---
# Ventana del límite de peticiones en milisegundos (3600000 = 1 hora)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000
BCRYPT_ROUNDS=10

# --- Logs (formato de morgan: dev, combined, common...) ---
LOG_LEVEL=dev

# --- Institución ---
# Se muestran en el login, el pie de página y los PDF. GET /api los entrega
# al Frontend (es público). Si una variable queda vacía, esa línea no se muestra.
INSTITUTION_NAME=Nombre de la institución
INSTITUTION_LOCATION=Ciudad, Estado
INSTITUTION_EMAIL=contacto@example.com
INSTITUTION_PHONE=(000) 000-0000
INSTITUTION_HOURS=Lun - Vie: 8:00 AM - 4:00 PM

# --- Sistema ---
# Correo del usuario interno "Sistema" (recibe el historial de las personas
# que se borran; no aparece en la lista de usuarios). Si ya existe con otro
# correo en tu base, pon aquí ese correo.
SYSTEM_USER_EMAIL=sistema@sistema.local
# Script que ejecuta el botón "Respaldo manual" de Seguridad (no viene en el
# repositorio). Si se deja vacío, el botón avisa que no está configurado.
BACKUP_SCRIPT=
